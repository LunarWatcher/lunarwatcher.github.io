{% extends "base.iris" %}
{% block content %}
    {% include "content" %}

    {% if exists("listing") %}
        {% for itPage in listing.pages %}
            <article class="flex-vertical list">
                <h2><a href="{{ abspath(itPage.url) }}">{{ itPage.title }}</a></h2>
                {% if existsIn(itPage, "date") %}
                    <span class="grey">
                        Published on {{ formatDate(itPage.date, "%F at %H:%M:%OS%Oz", "Europe/Oslo") }}
                        {% if existsIn(itPage, "last_modified") %}
                            · Last modified {{ formatDate(itPage.last_modified, "%F at %H:%M:%OS%Oz", "Europe/Oslo") }}
                        {% endif %}
                    </span>
                {% endif %}

                {% if existsIn(itPage, "summary") %}
                    <p>{{ itPage.summary }}</p>
                {% endif %}
                {# TODO: should this just be available if a summary is set?  #}
                <p style="margin: 0px"><a href="{{ abspath(itPage.url) }}">Read more...</a></p>
                {% if existsIn(itPage, "taxonomies") and existsIn(itPage.taxonomies, "tags") %}
                    <div class="tag-container flex-horizontal" style="margin-top: 4px">
                        {% for tag in itPage.taxonomies.tags %}
                            <span class="tag flex-shrink">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </article>
        {% endfor %}

        {% include "partials/paginator.iris" %}
    {% else %}
        <p>error: It seems <i>someone</i> did a dumdum and itPage_list fell back to the _default that's meant for paginated itPage
            lists. I'm sure she knows she's a bad girl</p>
    {% endif %}
{% endblock %}
