<aside id="notes-sidebar">
    <h2>Notes and thoughts index</h2>
    {# For whatever reason, setting the context inline does not work and results in a syntax error #}
    {% set subtree = treePages("/notes") %}
    {% set context = {
        "page": page,
        "site": site
    } %}

    <p>(<a href="{{ abspath("/notes/index.html") }}">What's this?</a>)</p>
    <ul id="recursive-list-root">
        {% for nextTree in subtree.subfolders %}
            {% set context.currTree = nextTree %}
            <li>{{ recurseInclude("partials/note-tree-builder.iris", context) }}</li>
        {% endfor %}
    </ul>
</aside>
